</head>
<body class="min-h-screen text-gray-800 flex flex-col justify-between items-center relative font-serif">

    <!-- Canvas for Floating & Scattering Blush Petals -->
    <canvas id="petalCanvas" class="fixed inset-0 pointer-events-none z-40" width="363" height="368"></canvas>

    <!-- Header & Ambient Audio Controls -->
    <header class="w-full max-w-4xl mx-auto p-4 flex justify-between items-center z-50">
        <div class="flex items-center space-x-2">
            <span class="text-xs uppercase tracking-widest text-champagne font-sans font-medium">Wedding Invitation</span>
        </div>
        
        <button id="audioToggleBtn" class="flex items-center space-x-2 bg-creamLight border border-gold/40 px-4 py-1.5 rounded-full shadow-sm text-xs font-sans text-champagne hover:text-goldDark transition-all duration-300">
            <i id="audioIcon" class="fas text-gold me-1 fa-pause"></i>
            <span id="audioText">Pause Music</span>
        </button>
    </header>

    <!-- Main Content Container -->
    <main class="w-full max-w-4xl mx-auto flex-1 flex flex-col items-center justify-center p-4 my-2 relative z-30">

        <!-- Reopen / Close Control Bar (Appears when invitation is opened) -->
        <div id="controlBar" class="mb-6 transition-opacity duration-500 flex items-center space-x-3 opacity-100">
            <button id="closeEnvBtn" class="bg-creamLight border border-gold/50 text-champagne hover:text-goldDark font-sans text-xs uppercase tracking-wider px-4 py-2 rounded-full shadow-md flex items-center space-x-2 transition-all">
                <i class="fas fa-envelope-open text-gold"></i>
                <span>Fold Back Into Envelope</span>
            </button>
        </div>

        <!-- 3D Interactive Envelope Container -->
        <div class="perspective-container w-full max-w-lg mx-auto flex justify-center items-center">
            
            <div id="envelopeWrapper" class="envelope-wrapper relative w-[320px] sm:w-[420px] md:w-[480px] h-[240px] sm:h-[300px] md:h-[330px] cursor-pointer open">
                
                <!-- 1. Envelope Interior Background -->
                <div class="absolute inset-0 bg-[#F3EDE2] rounded-lg border border-gold/30 shadow-2xl overflow-hidden">
                    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(#C5A059 0.75px, transparent 0.75px); background-size: 12px 12px;"></div>
                </div>

                <!-- 2. INVITATION CARD (Slides out of envelope) -->
                <div id="invitationCard" class="invitation-card absolute inset-x-2 sm:inset-x-3 top-2 min-h-[380px] sm:min-h-[430px] md:min-h-[460px] bg-creamLight border-2 border-gold/50 rounded-lg p-4 sm:p-7 text-center flex flex-col justify-between shadow-xl">
                    
                    <!-- Top Tulip & Feather Decorative SVG Header -->
                    <div class="relative w-full flex flex-col items-center">
                        <div class="w-full flex justify-between items-center px-2">
                            <span class="text-gold text-xs">✦</span>
                            <div class="h-[1px] bg-gradient-to-r from-transparent via-gold/50 to-transparent flex-1 mx-3"></div>
                            <span class="text-gold text-xs">✦</span>
                        </div>
                        
                        <div class="my-1 flex justify-center items-center">
                            <svg width="36" height="36" class="sm:w-11 sm:h-11" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Subtle feather backdrop -->
                                <path d="M30 75C20 60 25 45 35 35C40 50 35 65 30 75Z" fill="#FDEBEB" opacity="0.8"></path>
                                <path d="M70 75C80 60 75 45 65 35C60 50 65 65 70 75Z" fill="#FDEBEB" opacity="0.8"></path>
                                <!-- Stem -->
                                <path d="M50 90 Q 50 65 50 45" stroke="#A8BBA2" stroke-width="2.5" stroke-linecap="round"></path>
                                <!-- Blush Tulip Petals -->
                                <path d="M50 48 C30 45 30 20 42 15 C46 25 48 35 50 48 Z" fill="#F4C2C2"></path>
                                <path d="M50 48 C70 45 70 20 58 15 C54 25 52 35 50 48 Z" fill="#E09F9F"></path>
                                <path d="M40 30 C45 12 55 12 60 30 C54 40 46 40 40 30 Z" fill="#F7D6D6"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- EXACT INVITATION TEXT CONTENT -->
                    <div class="my-auto space-y-2 sm:space-y-3">
                        <p class="font-serif italic text-gray-600 text-xs sm:text-base md:text-lg leading-relaxed">
                            With love in their hearts<br>
                            and joy in their souls,
                        </p>

                        <!-- Couple Names - Beautiful 2-Line Layout with Glowing Heart -->
                        <div class="py-1 flex flex-col items-center justify-center space-y-0.5 sm:space-y-1">
                            <h1 class="font-script text-xl sm:text-3xl md:text-4xl text-gold-gradient leading-tight font-normal text-center w-full px-1">
                                Yoon Nadi Zaw
                            </h1>
                            <div class="text-[10px] sm:text-sm text-blushDark animate-pulse">
                                💕
                            </div>
                            <h1 class="font-script text-xl sm:text-3xl md:text-4xl text-gold-gradient leading-tight font-normal text-center w-full px-1">
                                Chan Min Khant
                            </h1>
                        </div>

                        <p class="font-serif italic text-gray-600 text-xs sm:text-base md:text-lg leading-relaxed">
                            invite you to witness<br>
                            the beginning of their forever.
                        </p>

                        <p class="font-serif italic text-gray-500 text-[11px] sm:text-sm md:text-base pt-0.5">
                            A day of love, laughter and beautiful memories
                        </p>
                    </div>

                    <!-- WEDDING DETAILS -->
                    <div class="mt-2 sm:mt-4 pt-2 sm:pt-3 border-t border-gold/30 flex flex-col items-center">
                        <div class="font-sans text-[11px] sm:text-sm tracking-widest text-champagne uppercase font-medium">
                            Saturday, 05 December 2026
                        </div>
                        <div class="font-sans text-[10px] sm:text-xs text-gray-500 tracking-wider mt-0.5">
                            7:00 AM – 11:00 AM
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-3 flex flex-wrap justify-center gap-1.5 sm:gap-2 font-sans">
                            <button id="rsvpBtn" class="bg-gradient-to-r from-gold to-champagne hover:from-goldDark hover:to-champagne text-white text-[11px] sm:text-xs px-3.5 py-1.5 rounded-full shadow transition-all duration-300">
                                RSVP / Best Wishes
                            </button>
                            <button id="addToCalBtn" class="bg-blushLight hover:bg-blush/40 text-gray-700 border border-gold/30 text-[11px] sm:text-xs px-3 py-1.5 rounded-full transition-all duration-300 flex items-center space-x-1">
                                <i class="far fa-calendar-plus text-gold me-1"></i>
                                <span>Add to Calendar</span>
                            </button>
                        </div>
                    </div>

                </div> <!-- End Invitation Card -->

                <!-- 3. Envelope Side & Bottom Folds -->
                <div class="absolute inset-0 pointer-events-none z-20">
                    <div class="absolute inset-y-0 left-0 w-1/2 bg-[#F9F5EF] border-r border-gold/20 shadow-md" style="clip-path: polygon(0 0, 0 100%, 100% 50%);"></div>
                    <div class="absolute inset-y-0 right-0 w-1/2 bg-[#F6F1EA] border-l border-gold/20 shadow-md" style="clip-path: polygon(100% 0, 100% 100%, 0 50%);"></div>
                    <div class="absolute inset-x-0 bottom-0 h-3/5 bg-[#FFFDF9] border-t border-gold/30 shadow-lg" style="clip-path: polygon(0 100%, 100% 100%, 50% 0);"></div>
                </div>

                <!-- Soft Tulip & Feather Accents Overlaying Envelope -->
                <div class="absolute -bottom-3 -left-4 z-30 pointer-events-none w-20 h-20 animate-float">
                    <svg viewBox="0 0 100 100" fill="none">
                        <path d="M10 80 Q 40 50 80 20 Q 50 60 10 80 Z" fill="#FFFFFF" opacity="0.85"></path>
                        <path d="M35 70 C 20 40 40 25 55 35 C 50 55 40 65 35 70 Z" fill="#F4C2C2"></path>
                        <path d="M45 72 C 35 45 55 30 65 40 C 60 60 50 68 45 72 Z" fill="#E09F9F" opacity="0.9"></path>
                    </svg>
                </div>

                <div class="absolute -bottom-3 -right-4 z-30 pointer-events-none w-20 h-20 transform scale-x-[-1] animate-float-delayed">
                    <svg viewBox="0 0 100 100" fill="none">
                        <path d="M10 80 Q 40 50 80 20 Q 50 60 10 80 Z" fill="#FFFFFF" opacity="0.85"></path>
                        <path d="M35 70 C 20 40 40 25 55 35 C 50 55 40 65 35 70 Z" fill="#F4C2C2"></path>
                        <path d="M45 72 C 35 45 55 30 65 40 C 60 60 50 68 45 72 Z" fill="#E09F9F" opacity="0.9"></path>
                    </svg>
                </div>

                <!-- 4. Envelope Top Triangular Flap -->
                <div id="envelopeFlap" class="envelope-flap absolute inset-x-0 top-0 h-3/5 bg-[#F9F5EF] border-b border-gold/30 rounded-t-lg origin-top" style="clip-path: polygon(0 0, 100% 0, 50% 100%);">
                    <div class="absolute inset-0 bg-gradient-to-b from-white/40 to-transparent"></div>
                </div>

                <!-- 5. Realistic Gold Wax Seal (Y & C Emblem) -->
                <div id="waxSeal" class="wax-seal absolute top-[52%] left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-14 h-14 sm:w-16 sm:h-16 bg-gradient-to-br from-goldLight via-gold to-goldDark rounded-full border-2 border-goldLight/80 flex items-center justify-center z-30 cursor-pointer">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full border border-yellow-100/50 flex items-center justify-center bg-gold/30 backdrop-blur-xs">
                        <span class="font-script text-white text-lg sm:text-xl drop-shadow-md select-none">Y &amp; C</span>
                    </div>
                </div>

            </div> <!-- End Envelope Wrapper -->

        </div>

        <!-- Tap Hint Prompt -->
        <div id="tapHint" class="mt-8 text-center transition-opacity duration-500 opacity-0">
            <p class="font-sans text-xs tracking-widest uppercase text-champagne animate-pulse flex items-center justify-center space-x-2">
                <i class="fas fa-hand-pointer text-gold"></i>
                <span>Tap the envelope to open</span>
            </p>
        </div>

        <!-- Live Countdown Timer -->
        <div id="countdownSection" class="w-full max-w-md mx-auto mt-10 bg-creamLight/80 backdrop-blur-md border border-gold/30 rounded-2xl p-4 shadow-sm text-center">
            <h3 class="font-serif italic text-gray-700 text-sm mb-3">Counting down to our special day</h3>
            <div class="grid grid-cols-4 gap-2 font-sans">
                <div class="bg-cream rounded-xl p-2 border border-gold/20">
                    <span id="cdDays" class="block text-xl font-semibold text-champagne">29</span>
                    <span class="text-[10px] uppercase tracking-wider text-gray-500">Days</span>
                </div>
                <div class="bg-cream rounded-xl p-2 border border-gold/20">
                    <span id="cdHours" class="block text-xl font-semibold text-champagne">18</span>
                    <span class="text-[10px] uppercase tracking-wider text-gray-500">Hours</span>
                </div>
                <div class="bg-cream rounded-xl p-2 border border-gold/20">
                    <span id="cdMins" class="block text-xl font-semibold text-champagne">19</span>
                    <span class="text-[10px] uppercase tracking-wider text-gray-500">Mins</span>
                </div>
                <div class="bg-cream rounded-xl p-2 border border-gold/20">
                    <span id="cdSecs" class="block text-xl font-semibold text-champagne">14</span>
                    <span class="text-[10px] uppercase tracking-wider text-gray-500">Secs</span>
                </div>
            </div>
        </div>

    </main>

    <!-- RSVP Modal -->
    <div id="rsvpModal" class="fixed inset-0 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300 z-50">
        <div class="bg-creamLight border border-gold/40 rounded-2xl max-w-md w-full p-6 shadow-2xl relative font-serif transform scale-95 transition-transform duration-300" id="rsvpModalContent">
            <button id="closeRsvpBtn" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-lg"></i>
            </button>

            <h3 class="font-script text-3xl text-gold-gradient text-center mb-1">Send Best Wishes</h3>
            <p class="font-sans text-xs text-gray-500 text-center mb-4">We would love to hear from you!</p>

            <form id="rsvpForm" class="space-y-3 font-sans text-xs">
                <div>
                    <label class="block text-gray-700 mb-1">Your Name</label>
                    <input type="text" required="" class="w-full bg-cream border border-gold/30 rounded-lg p-2.5 outline-none focus:border-gold transition-colors" placeholder="e.g., Sarah &amp; Family">
                </div>
                <div>
                    <label class="block text-gray-700 mb-1">Attendance</label>
                    <select class="w-full bg-cream border border-gold/30 rounded-lg p-2.5 outline-none focus:border-gold transition-colors">
                        <option>Joyfully Attending</option>
                        <option>Regretfully Declining</option>
                        <option>Sending Warmest Wishes</option>
                    </select>
                </div>
                <div>
                    <label class="block text-gray-700 mb-1">Message / Wish</label>
                    <textarea rows="3" class="w-full bg-cream border border-gold/30 rounded-lg p-2.5 outline-none focus:border-gold transition-colors" placeholder="Write a note for Yoon Nadi Zaw &amp; Chan Min Khant..."></textarea>
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-gold to-champagne hover:from-goldDark hover:to-champagne text-white py-2.5 rounded-lg shadow font-medium text-xs tracking-wider uppercase transition-all duration-300">
                    Send Wishes
                </button>
            </form>

            <div id="rsvpSuccessMsg" class="hidden text-center py-6 space-y-2">
                <i class="fas fa-heart text-blushDark text-3xl animate-bounce"></i>
                <h4 class="font-serif text-lg text-gray-800">Thank You!</h4>
                <p class="font-sans text-xs text-gray-500">Your warm wishes have been sent to the couple.</p>
            </div>
        </div>
    </div>

