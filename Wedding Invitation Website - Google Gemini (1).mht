.mdc-text-field { display: inline-flex; align-items: baseline; padding: 0px 16px; position: relative; box-sizing: border-box; overflow: hidden; will-change: opacity, transform, color; border-radius: 4px 4px 0px 0px; }

.mdc-text-field__input { width: 100%; min-width: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 0px; background: none; padding: 0px; appearance: none; height: 28px; }

.mdc-text-field__input::-webkit-calendar-picker-indicator, .mdc-text-field__input::-webkit-search-cancel-button { display: none; }

.mdc-text-field__input:focus { outline: none; }

.mdc-text-field__input:invalid { box-shadow: none; }

.mdc-text-field__input::placeholder { opacity: 0; }

.mdc-text-field__input::-webkit-input-placeholder { opacity: 0; }

