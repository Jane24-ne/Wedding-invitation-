                                <!-- Blush Tulip Petals -->
                                <path d="M50 48 C30 45 30 20 42 15 C46 25 48 35 50 48 Z" fill="#F4C2C2"></path>
                                <path d="M50 48 C70 45 70 20 58 15 C54 25 52 35 50 48 Z" fill="#E09F9F"></path>
                                <path d="M40 30 C45 12 55 12 60 30 C54 40 46 40 40 30 Z" fill="#F7D6D6"></path>
                            </svg>
